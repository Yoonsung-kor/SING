OPENAI_API_KEY=
# 추론 강도(reasoning)를 지원하는 모델이어야 해요. 예: gpt-5.5
OPENAI_MODEL=gpt-5.5

# YouTube Data API v3 키. 곡 상세 화면의 영상 자동 찾기에 써요. 비우면 링크 붙여넣기만 돼요.
YOUTUBE_API_KEY=

# ── 친구들과 함께 쓰는 서버에서만 (이 PC에서는 비워 두세요) ──
# 듣는 주소. 배포 서버에서는 0.0.0.0
HOST=
# 초대 코드. 영문자·숫자·-·_로 8~64자. 쉼표로 여러 개. 비우면 아무것도 검사하지 않아요.
INVITE_CODES=
# 사용량 보기 주소(/api/admin/stats?key=…)의 열쇠. 16자 이상. 비우면 그 주소가 없어요.
ADMIN_KEY=
# 구글 설문 주소. 사용 요약이 들어갈 자리에 __USAGE__를 적어요. 비우면 "의견 남기기"가 안 보여요.
FEEDBACK_FORM_URL=
# 1이면 프록시가 붙인 X-Forwarded-For의 첫 주소를 접속 주소로 써요(Render).
TRUST_PROXY=
# 하루 한도를 바꿀 때만: 전체 AI 요청(기본 200), 기기 하나의 AI 요청(30), 기기 하나의 영상 찾기(20)
AI_DAILY_LIMIT=
AI_DEVICE_DAILY_LIMIT=
VIDEO_DEVICE_DAILY_LIMIT=
